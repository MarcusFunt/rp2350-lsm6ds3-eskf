{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcusFunt/rp2350-lsm6ds3-eskf/external_benchmarks/schema/adapter_manifest_v1.schema.json",
  "title": "External benchmark adapter manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "schema_version", "adapter_id", "variant_id", "algorithm_name",
    "implementation_version", "execution_mode", "supported_sensor_sets", "supported_aid_types",
    "supported_timestamp_units", "supported_sampling_modes", "allowed_yaw_gauges",
    "initialization", "output_convention", "source_fidelity"
  ],
  "properties": {
    "schema_id": {"const": "org.marcusfunt.external_benchmarks.adapter_manifest"},
    "schema_version": {"const": 1},
    "adapter_id": {"type": "string", "minLength": 1},
    "variant_id": {"type": "string", "minLength": 1},
    "algorithm_name": {"type": "string", "minLength": 1},
    "implementation_version": {"type": "string", "minLength": 1},
    "execution_mode": {"enum": ["causal_online", "offline_batch"]},
    "supported_sensor_sets": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["gyro_accel_6d", "gyro_accel_mag_9d"]}
    },
    "supported_aid_types": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["independent_heading", "magnetometer"]}
    },
    "supported_timestamp_units": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["ns", "us"]}
    },
    "supported_sampling_modes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["uniform", "irregular"]}
    },
    "allowed_yaw_gauges": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["unobservable_startup", "independent_heading", "magnetic_reference", "provided_initial_yaw"]}
    },
    "initialization": {"$ref": "#/$defs/initialization"},
    "output_convention": {"$ref": "#/$defs/output_convention"},
    "source_fidelity": {"$ref": "#/$defs/source_fidelity"}
  },
  "$defs": {
    "sha256_or_null": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "initialization": {
      "type": "object", "additionalProperties": false,
      "required": ["orientation_source", "initial_yaw_gauge", "uses_truth", "warmup_policy", "reset_clears_all_state"],
      "properties": {
        "orientation_source": {"enum": ["identity", "gravity_aligned_zero_yaw", "provided_config", "algorithm_default"]},
        "initial_yaw_gauge": {"enum": ["unobservable_startup", "independent_heading", "magnetic_reference", "provided_initial_yaw"]},
        "uses_truth": {"type": "boolean"},
        "warmup_policy": {"type": "string", "minLength": 1},
        "reset_clears_all_state": {"const": true}
      }
    },
    "output_convention": {
      "type": "object", "additionalProperties": false,
      "required": ["quaternion_order", "rotation_direction", "reference_world_frame", "gravity_world_mps2", "accelerometer_quantity"],
      "properties": {
        "quaternion_order": {"const": "wxyz"},
        "rotation_direction": {"const": "body_to_world"},
        "reference_world_frame": {"const": "ENU"},
        "gravity_world_mps2": {"const": [0, 0, -9.80665]},
        "accelerometer_quantity": {"const": "specific_force"}
      }
    },
    "source_fidelity": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "source_uri", "source_revision", "implementation_sha256", "adapter_sha256", "model_sha256", "license"],
      "properties": {
        "classification": {"enum": ["official_unmodified", "official_wrapper_only", "faithful_reimplementation", "internal_historical", "project_implementation"]},
        "source_uri": {"type": "string", "format": "uri", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "implementation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "adapter_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_sha256": {"$ref": "#/$defs/sha256_or_null"},
        "license": {"type": "string", "minLength": 1}
      }
    }
  }
}
