{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcusFunt/rp2350-lsm6ds3-eskf/external_benchmarks/schema/estimator_output_v1.schema.json",
  "title": "External benchmark estimator output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "schema_version", "trial_id", "source_id", "sensor_set", "execution_mode",
    "sample_count", "input_sha256", "config_sha256", "adapter_manifest", "samples"
  ],
  "properties": {
    "schema_id": {"const": "org.marcusfunt.external_benchmarks.estimator_output"},
    "schema_version": {"const": 1},
    "trial_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "sensor_set": {"enum": ["gyro_accel_6d", "gyro_accel_mag_9d"]},
    "execution_mode": {"enum": ["causal_online", "offline_batch"]},
    "sample_count": {"type": "integer", "minimum": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter_manifest": {"$ref": "adapter_manifest_v1.schema.json"},
    "samples": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/estimator_sample"}
    }
  },
  "$defs": {
    "vector3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "estimator_sample": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_index", "timestamp", "orientation_valid", "status", "orientation"],
      "properties": {
        "sample_index": {"type": "integer", "minimum": 0},
        "timestamp": {"type": "integer", "minimum": 0},
        "orientation_valid": {"type": "boolean"},
        "status": {"enum": ["valid", "warming_up", "invalid", "failed"]},
        "orientation": {
          "oneOf": [
            {"$ref": "#/$defs/orientation"},
            {"type": "null"}
          ]
        },
        "bias": {"oneOf": [{"$ref": "#/$defs/bias"}, {"type": "null"}]},
        "covariance": {"oneOf": [{"$ref": "#/$defs/covariance"}, {"type": "null"}]},
        "navigation": {"oneOf": [{"$ref": "#/$defs/navigation"}, {"type": "null"}]},
        "processing_time_ns": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"orientation_valid": {"const": true}}, "required": ["orientation_valid"]},
          "then": {"properties": {"status": {"const": "valid"}, "orientation": {"$ref": "#/$defs/orientation"}}}
        },
        {
          "if": {"properties": {"orientation_valid": {"const": false}}, "required": ["orientation_valid"]},
          "then": {"properties": {"status": {"enum": ["warming_up", "invalid", "failed"]}, "orientation": {"type": "null"}}}
        }
      ]
    },
    "orientation": {
      "type": "object", "additionalProperties": false,
      "required": ["quaternion_wxyz", "yaw_gauge"],
      "properties": {
        "quaternion_wxyz": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
        "yaw_gauge": {"enum": ["unobservable_startup", "independent_heading", "magnetic_reference", "provided_initial_yaw"]}
      }
    },
    "bias": {
      "type": "object", "additionalProperties": false,
      "required": ["accelerometer_mps2", "gyroscope_rad_s"],
      "properties": {"accelerometer_mps2": {"$ref": "#/$defs/vector3"}, "gyroscope_rad_s": {"$ref": "#/$defs/vector3"}}
    },
    "covariance": {
      "type": "object", "additionalProperties": false,
      "required": ["state_order", "state_units", "representation", "values_row_major"],
      "properties": {
        "state_order": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "state_units": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "representation": {"const": "row_major"},
        "values_row_major": {"type": "array", "items": {"type": "number"}, "minItems": 1}
      }
    },
    "navigation": {
      "type": "object", "additionalProperties": false,
      "required": ["position_enu_m", "velocity_enu_m_s"],
      "properties": {"position_enu_m": {"$ref": "#/$defs/vector3"}, "velocity_enu_m_s": {"$ref": "#/$defs/vector3"}}
    }
  }
}
